# Free tier (recommended): https://console.groq.com/keys
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_groq_key_here
GROQ_MODEL=openai/gpt-oss-20b

# DeepSeek (OpenAI-compatible): https://platform.deepseek.com/api_keys
# LLM_PROVIDER=deepseek
# DEEPSEEK_API_KEY=sk-your_deepseek_key_here
# DEEPSEEK_MODEL=deepseek-chat

# Optional OpenAI (paid)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your_key_here
# OPENAI_MODEL=gpt-4.1-mini

# Interpret budget (rules-first; abandon LLM on timeout — see docs/contract/evaluation.md)
# LLM_INTERPRET_TIMEOUT_SEC=15
# LLM_HTTP_TIMEOUT_SEC=20

SUPPLYMATE_API_URL=http://127.0.0.1:8000

# development | production | test (test disables strict rate limits in pytest)
SUPPLYMATE_ENV=development
CHAT_RATE_LIMIT_PER_MIN=10
MAX_CHAT_MESSAGE_LENGTH=2000
MAX_SCOPE_VALUE_LENGTH=200
# Resource CSVs under data/ are the simulated API (default).
# SUPPLYMATE_DATA_DIR=./data
# Optional: load raw xlsx instead (normally leave empty)
# SUPPLYMATE_CATALOG_XLSX=
